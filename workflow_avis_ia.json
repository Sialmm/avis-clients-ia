    {
      "name": "Statistiques semaine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        224
      ],
      "parameters": {
        "jsCode": "const limite = new Date(Date.now() - 7 * 24 * 3600 * 1000).toISOString().slice(0, 10);\nconst semaine = $input.all().map(i => i.json).filter(a => a.date >= limite);\nconst parResto = {};\nfor (const a of semaine) {\n  if (!parResto[a.restaurant]) parResto[a.restaurant] = { n: 0, notes: 0, negatifs: 0 };\n  const r = parResto[a.restaurant];\n  r.n += 1; r.notes += Number(a.note) || 0; if (a.sentiment === 'negatif') r.negatifs += 1;\n}\nconst lignes = Object.keys(parResto).map(nom => {\n  const r = parResto[nom];\n  return '<tr><td>' + nom + '</td><td>' + r.n + '</td><td>' + (r.notes / r.n).toFixed(1) + '</td><td>' + r.negatifs + '</td></tr>';\n}).join('');\nconst negatifs = semaine.filter(a => a.sentiment === 'negatif');\nconst compte = {};\nfor (const a of negatifs) {\n  for (const t of String(a.themes || '').split(', ').filter(Boolean)) {\n    const cle = a.restaurant + ' : ' + t;\n    compte[cle] = (compte[cle] || 0) + 1;\n  }\n}\nconst recurrents = Object.keys(compte).filter(k => compte[k] >= 2).sort((a, b) => compte[b] - compte[a]);\nconst aTraiter = semaine.filter(a => a.sentiment !== 'positif')\n  .map(a => '- ' + a.restaurant + ' (' + a.note + '/5, thèmes : ' + a.themes + ') : ' + a.resume).join('\\n');\nreturn [{ json: {\n  nb: semaine.length,\n  tableau: lignes,\n  recurrentsHtml: recurrents.map(k => '<li><b>' + k + '</b> (' + compte[k] + ' avis)</li>').join(''),\n  negatifsHtml: negatifs.map(a => '<li>' + a.restaurant + ' (' + a.note + '/5) : ' + a.resume + '</li>').join(''),\n  promptIA: aTraiter || 'Aucun avis négatif ou neutre cette semaine.'\n}}];"
      }
    },
    {
      "name": "IA - priorités de la semaine",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1872,
        224
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Avis de la semaine à traiter :\n{{ $json.promptIA }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Tu es consultant pour une chaîne de restaurants. À partir des avis de la semaine, propose au maximum 3 pistes d'amélioration concrètes pour les managers. Mets en avant les problèmes qui reviennent dans plusieurs avis ; ne surréagis pas à une critique isolée et présente-la comme un point à surveiller. Réponds uniquement en HTML simple : une liste <ul> de <li>, chacune avec le restaurant concerné et la piste. S'il n'y a aucun avis négatif, félicite l'équipe en une phrase dans un <p>."
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Gemini (rapport)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1872,
        448
      ],
      "parameters": {
        "modelName": "models/gemini-3-flash-preview",
        "options": {
          "temperature": 0.3
        }
      }
    },
    {
      "name": "Construire le mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2096,
        224
      ],
      "parameters": {
        "jsCode": "const s = $('Statistiques semaine').first().json;\nconst priorites = ($input.first().json.text || '').replace(/```html|```/g, '');\nlet html = '<h2>Rapport hebdomadaire des avis clients</h2>';\nhtml += '<p>' + s.nb + ' avis publiés ces 7 derniers jours.</p>';\nhtml += '<table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\"><tr><th>Restaurant</th><th>Avis</th><th>Note moyenne</th><th>Négatifs</th></tr>' + s.tableau + '</table>';\nhtml += '<h3>Pistes d\\'amélioration (IA)</h3>' + priorites;\nif (s.recurrentsHtml) html += '<h3>Sujets qui reviennent cette semaine</h3><ul>' + s.recurrentsHtml + '</ul>';\nif (s.negatifsHtml) html += '<h3>Avis négatifs à prendre en compte</h3><p style=\"color:#666\">Un avis isolé n\\'est pas forcément représentatif : à lire pour repérer une tendance.</p><ul>' + s.negatifsHtml + '</ul>';\nreturn [{ json: { html } }];"
      }
    },
    {
      "name": "Envoyer aux managers",
