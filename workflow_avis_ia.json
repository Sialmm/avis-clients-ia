    {
      "name": "Google Places - avis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        96
      ],
      "parameters": {
        "method": "POST",
        "url": "https://places.googleapis.com/v1/places:searchText",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Goog-FieldMask",
              "value": "places.id,places.displayName,places.formattedAddress,places.rating,places.reviews"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ textQuery: $json.searchQuery, languageCode: \"fr\", regionCode: \"FR\", maxResultCount: 20 }) }}",
        "options": {}
      }
    },
    {
      "name": "Extraire les avis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        96
      ],
      "parameters": {
        "jsCode": "// Transforme la réponse Google Places en un item par avis\nconst cfg = $('Config').first().json;\nconst filtre = (cfg.nameFilter || '').toLowerCase();\nconst pays = (cfg.pays || '').toLowerCase();\nconst places = $input.first().json.places || [];\nconst out = [];\nfor (const p of places) {\n  const nom = p.displayName?.text || 'Inconnu';\n  const adresse = p.formattedAddress || '';\n  if (filtre && !nom.toLowerCase().includes(filtre)) continue;\n  if (pays && !adresse.toLowerCase().endsWith(pays)) continue;\n  for (const r of (p.reviews || [])) {\n    const texte = r.text?.text || r.originalText?.text || '';\n    if (!texte.trim()) continue; // on ignore les avis sans texte\n    out.push({ json: {\n      review_id: r.name,\n      date: (r.publishTime || '').slice(0, 10),\n      restaurant: nom,\n      adresse: adresse,\n      note: r.rating ?? null,\n      auteur: r.authorAttribution?.displayName || '',\n      avis: texte,\n    }});\n  }\n}\nreturn out;"
      }
    },
    {
      "name": "Regrouper les avis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        864,
        96
      ],
      "parameters": {
        "jsCode": "const avis = $input.all().map((it, i) => '[' + i + '] Restaurant : ' + it.json.restaurant + ' | Note : ' + it.json.note + '/5 | Avis : ' + String(it.json.avis).replace(/\\s+/g, ' '));\nreturn [{ json: { nb: avis.length, listeAvis: avis.join('\\n') } }];"
      }
    },
    {
      "name": "IA - classer les avis",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1088,
        96
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Voici {{ $json.nb }} avis numérotés :\n{{ $json.listeAvis }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "Tu analyses des avis clients de restaurants. Pour CHAQUE avis numéroté, renvoie un objet dans la liste \"avis\" avec : id (le numéro entre crochets), sentiment (positif, neutre ou negatif), score (entier de -2 à 2), themes (liste parmi : service, attente, qualite, prix, livraison, proprete, ambiance, autre), urgence (haute, moyenne ou basse ; haute = hygiène, santé, client très mécontent ou erreur grave) et resume (une phrase de 15 mots maximum, en français). N'oublie aucun avis."
            }
          ]
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "name": "Gemini (classification)",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        1040,
        320
      ],
      "parameters": {
        "modelName": "models/gemini-3-flash-preview",
        "options": {
          "temperature": 0,
          "maxOutputTokens": 16000
        }
      }
    },
    {
      "name": "Format de sortie",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1216,
        320
      ],
      "parameters": {
        "jsonSchemaExample": "{ \"avis\": [ { \"id\": 0, \"sentiment\": \"negatif\", \"score\": -1, \"themes\": [\"attente\", \"service\"], \"urgence\": \"moyenne\", \"resume\": \"Attente trop longue malgré un service aimable\" } ] }"
      }
    },
    {
      "name": "Fusionner avis + IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1424,
        96
      ],
      "parameters": {
        "jsCode": "const res = ($input.first().json.output && $input.first().json.output.avis) || [];\nconst parId = {};\nfor (const c of res) parId[c.id] = c;\nconst today = new Date().toISOString().slice(0, 10);\nreturn $('Extraire les avis').all().map((it, i) => {\n  const c = parId[i] || {};\n  return { json: {\n    ...it.json,\n    sentiment: c.sentiment || '',\n    score: c.score ?? '',\n    themes: Array.isArray(c.themes) ? c.themes.join(', ') : (c.themes || ''),\n    urgence: c.urgence || '',\n    resume: c.resume || '',\n    traite_le: today\n  }};\n});"
      }
    },
